# Replace placeholders locally. Never commit real credentials.
JWT_SECRET=[SECRET_KEY]
JWT_TTL_MINUTES=60
ENVIRONMENT=local
POSTGRES_USER=privacy_feedback
POSTGRES_PASSWORD=[PASSWORD]
POSTGRES_DB=privacy_feedback
# Used when running the API directly from the host. Compose injects its own db-host URL.
DATABASE_URL=postgresql+psycopg://privacy_feedback:[PASSWORD]@127.0.0.1:5432/privacy_feedback
# Browser origins allowed to call the API during local Flutter Web development.
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Process-local M7 abuse-control defaults. Production should also enforce limits at the edge.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_JOIN_MAX_REQUESTS=10
RATE_LIMIT_GROUP_CREATE_MAX_REQUESTS=5
RATE_LIMIT_ROUND_CREATE_MAX_REQUESTS=10
RATE_LIMIT_CREDENTIAL_CLAIM_MAX_REQUESTS=5
