# Non-secret Render runtime template for the Anonymprove API.
# Copy these names into Render's environment configuration.
# Never commit real secret values.

ENVIRONMENT=production

# Replace the placeholder after Cloudflare Pages is deployed.
CORS_ORIGINS=https://anonymprove-web-beta.pages.dev

# Exact public Render host plus local container health-check hosts.
TRUSTED_HOSTS=anonymprove-api-beta.onrender.com,localhost,127.0.0.1

JWT_TTL_MINUTES=60

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_JOIN_MAX_REQUESTS=10
RATE_LIMIT_GROUP_CREATE_MAX_REQUESTS=5
RATE_LIMIT_ROUND_CREATE_MAX_REQUESTS=10
RATE_LIMIT_CREDENTIAL_CLAIM_MAX_REQUESTS=5

REQUEST_LOGGING_ENABLED=true
SECURITY_HEADERS_ENABLED=true
CREDENTIAL_METADATA_RETENTION_DAYS=30
DATABASE_POOL_RECYCLE_SECONDS=300

# Render supplies PORT automatically.

# Configure these in Render's Environment page; never commit their real values:
# JWT_SECRET=<secret, at least 32 characters>
# DATABASE_URL=<direct Neon SQLAlchemy/psycopg URL ending in sslmode=require&channel_binding=require>
