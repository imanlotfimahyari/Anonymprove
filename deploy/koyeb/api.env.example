# Non-secret Koyeb runtime template for the Anonymprove API.
# Copy these names into Koyeb's environment configuration.
# Never commit real secret values.

ENVIRONMENT=production
PORT=8000

# Configure after the public endpoints are known.
CORS_ORIGINS=https://<cloudflare-pages-host>
TRUSTED_HOSTS=<koyeb-api-host>

JWT_TTL_MINUTES=60

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_JOIN_MAX_REQUESTS=10
RATE_LIMIT_GROUP_CREATE_MAX_REQUESTS=5
RATE_LIMIT_ROUND_CREATE_MAX_REQUESTS=10
RATE_LIMIT_CREDENTIAL_CLAIM_MAX_REQUESTS=5

REQUEST_LOGGING_ENABLED=true
SECURITY_HEADERS_ENABLED=true
CREDENTIAL_METADATA_RETENTION_DAYS=30

# Configure these as Koyeb Secrets, not plaintext environment values:
# JWT_SECRET=<secret, at least 32 characters>
# DATABASE_URL=<Neon PostgreSQL SQLAlchemy/psycopg URL>
